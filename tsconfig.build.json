{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"types": [],
		"noEmit": false,
		"allowImportingTsExtensions": true,
		// Source imports name .ts files (Node runs the tests straight); the output names .js.
		"rewriteRelativeImportExtensions": true,
		"declaration": true,
		"outDir": "dist",
		"rootDir": "src"
	},
	"include": ["src"],
	"exclude": ["src/**/*.test.ts"]
}
