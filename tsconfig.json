{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		// The unit tests run straight in Node, which needs the extension.
		"allowImportingTsExtensions": true
	},
	"include": ["src", "test", "playwright.config.ts", "site/src", "site/*.ts"]
}
