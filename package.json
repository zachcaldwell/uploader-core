{
	"name": "uploader-core",
	"version": "0.0.1",
	"private": true,
	"description": "Compress images in the browser and upload them straight to your own bucket.",
	"type": "module",
	"license": "MIT",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"import": "./dist/server/index.js"
		},
		"./element": {
			"types": "./dist/element/index.d.ts",
			"import": "./dist/element/index.js"
		},
		"./element.css": "./dist/element.css",
		"./supabase": {
			"types": "./dist/supabase/index.d.ts",
			"import": "./dist/supabase/index.js"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"./dist/element/index.js",
		"*.css"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/element/element.css', 'dist/element.css')\"",
		"check": "tsc --noEmit",
		"test:unit": "node --test 'src/**/*.test.ts'",
		"test:browser": "node test/bundle.mjs && playwright test",
		"test": "npm run test:unit && npm run test:browser",
		"prepare": "npm run build"
	},
	"dependencies": {
		"pica": "^9.0.1"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@supabase/storage-js": "^2.119.0",
		"@types/node": "^22.20.5",
		"@types/pica": "^9.0.5",
		"esbuild": "^0.28.0",
		"typescript": "^6.0.3"
	}
}
